# =====================================================================
#  .bashrc.local.example — bash 机器差异（复制为 ~/.bashrc.local，主 .bashrc 自动 source）
#  只放本机 PATH、代理、SSH key、别名；通用配置改主 .bashrc。
#  分工与红线见 docs/machine-local.md。
# =====================================================================

# 本机 PATH（换机器要改的 SDK / brew 前缀）
# export PATH="$HOME/Library/go/sdk/go1.25.9/bin:/opt/homebrew/bin:$PATH"

# 代理（不走就注释掉）
# export http_proxy="http://127.0.0.1:7890"

# SSH key 只在交互 shell 加
# case "$-" in *i*) ssh-add "$HOME/.ssh/work_rsa" 2>/dev/null ;; esac
