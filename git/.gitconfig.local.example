# =====================================================================
#  .gitconfig.local.example — git 身份判定规则（复制为 ~/.gitconfig.local，填本机真值）
#  前提：master 末尾有 [include] path = ~/.gitconfig.local；
#        ~/.gitconfig.work、~/.gitconfig.personal 两个身份文件存在。
#  规则为什么这么排、边界、恢复步骤、自检：docs/git-identity.md
#  ⚠ 公开仓库：只写占位符，真值从手册的「占位符 ↔ 真值来源」抄。
# =====================================================================

# 目录维度：公司目录 → 公司身份；其中的个人目录 → 个人身份
[includeIf "gitdir:~/<公司项目根>/"]
	path = ~/.gitconfig.work
[includeIf "gitdir:~/<公司项目根>/<个人目录>/"]
	path = ~/.gitconfig.personal

# 远端维度·个人账号（ssh / https 两种克隆写法都要列，缺一种就静默漏判）
[includeIf "hasconfig:remote.*.url:git@github.com:<你的 GitHub 账号>/**"]
	path = ~/.gitconfig.personal
[includeIf "hasconfig:remote.*.url:https://github.com/<你的 GitHub 账号>/**"]
	path = ~/.gitconfig.personal

# 远端维度·公司（必须排最后：多远端冲突时落公司身份才是 fail-safe 方向）
# glob 必须写成 :**/**，写成 :** 不匹配（需 Git >= 2.36）
[includeIf "hasconfig:remote.*.url:git@<公司 GitLab 域名>:**/**"]
	path = ~/.gitconfig.work
