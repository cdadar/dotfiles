" =====================================================================
"  .vimrc.local.example — Vim 机器差异（复制为 ~/.vimrc.local，主 .vimrc 自动 source）
"  只放每台机器不同的东西：作者信息、本机代理、工具链路径、快捷键习惯。
"  通用配置改主 .vimrc。分工与红线见 docs/machine-local.md。
" =====================================================================

" 作者信息（Doxygen 注释用）
let g:DoxygenToolkit_authorName="你的名字, your@email.com"

" 本机代理（不走就注释掉）
" let g:netrw_proxy = "http://127.0.0.1:7890"

" 本机工具链 / 快捷键习惯（示例）
" let g:python3_host_prog = expand("~/.pyenv/shims/python3")
" inoremap jk <Esc>
