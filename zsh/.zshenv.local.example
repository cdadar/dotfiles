# =====================================================================
#  .zshenv.local.example — Zsh 机器差异·环境层（复制为 ~/.zshenv.local）
#  放【所有 zsh 进程都要看到】的机器差异：PATH 顺序、SDK 位置、工具环境变量。
#  交互专属（别名、ssh-add、补全）放 ~/.zshrc.local，别放这里。
#  本文件必须不产生 stdout（会污染 `$(zsh -c ...)`）。分工见 docs/machine-local.md。
# =====================================================================

# PATH 插队（要压过 path_helper 前置的 /usr/local/bin 时用；不存在会自动剔除）
# _dotfiles_path_head=(
#   $HOME/Library/go/sdk/go1.25.9/bin
#   "$HOME/Library/Application Support/JetBrains/Toolbox/scripts"
#   $_dotfiles_path_head
# )

# 工具环境变量（换机器要改的）
# export ANDROID_HOME="$HOME/Library/Android/sdk"
# export JAVA_HOME="$(/usr/libexec/java_home -v 17 2>/dev/null)"
