# =====================================================================
#  .zshrc.local.example — Zsh 机器差异·交互层（复制为 ~/.zshrc.local）
#  只放【交互 shell 专属】：别名、代理、ssh-add、补全。
#  环境变量 / PATH 放 ~/.zshenv.local（否则脚本、Emacs 拿不到）。
#  通用配置改主 .zshrc。分工见 docs/machine-local.md。
# =====================================================================

# 本机代理（不走就注释掉）
# export http_proxy="http://127.0.0.1:7890"
# export https_proxy="$http_proxy"

# 本机别名
# alias ll='ls -lAh --color=auto'

# master 的 alias 依赖这两个变量，不定义则 me / upgrade_emacs / upgrade_dotfiles 失效
# export EMACSD="$HOME/.emacs.d"
# export DOTFILES="$HOME/project/private/dotfiles/"
